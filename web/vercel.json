{"$schema": "https://openapi.vercel.sh/vercel.json", "buildCommand": "npm run build", "outputDirectory": "dist", "framework": "vite", "rewrites": [{"source": "/((?!data/|assets/).*)", "destination": "/index.html"}], "headers": [{"source": "/data/v1/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"key": "Content-Type", "value": "application/json; charset=utf-8"}]}, {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}, {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "SAMEORIGIN"}]}]}